{
  "manifest_version": 3,
  "name": "Delete AI Chat",
  "version": "1.0.0",
  "description": "Batch delete your AI chat history easily.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Delete AI Chat",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "assets/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://gemini.google.com/*"
      ],
      "js": [
        "assets/content_gemini.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://gemini.google.com/*"
  ]
}